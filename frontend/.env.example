# UPSKILL AI - frontend environment variables
#
# Copy this file to `.env` to override defaults. Vite only exposes variables
# that start with VITE_. NEVER put secrets here — this file is bundled into
# the static build and is publicly readable.
#
# Base URL of the backend API (the /api/v1 prefix is part of the value).
# Local development (Vite proxies /api/v1 to the backend automatically, so
# the default '/api/v1' also works):
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
#
# Production example (deployed backend):
# VITE_API_BASE_URL=https://upskill-api.onrender.com/api/v1
