# UPSKILL AI Environment Variables (project root template)
#
# The backend reads its variables from backend/.env (see backend/.env.example
# for the authoritative, fully documented list). This root file documents the
# same variables plus the frontend variable for deployment platforms.

# ── Backend (backend/.env or hosting provider's env vars) ──
PROJECT_NAME="UPSKILL AI"
API_V1_STR="/api/v1"
# Allowed frontend origins. ADD the deployed frontend URL in production.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# SQLite by default; PostgreSQL for production, e.g.
# DATABASE_URL="postgresql+psycopg://user:password@host:5432/upskill"
DATABASE_URL="sqlite:///./statlearn_ai.db"
# OpenRouter (AI calls happen only from the backend, never the frontend)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# JWT - generate a strong secret for production
JWT_SECRET_KEY="upskill-dev-secret-change-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Frontend (Vercel project env vars; Vite exposes only VITE_* names) ──
# Base URL of the backend API including the /api/v1 prefix. In production set
# this to the deployed backend, e.g. https://upskill-api.onrender.com/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
