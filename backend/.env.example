# UPSKILL AI - backend environment variables
#
# Copy this file to `.env` and fill in real values. NEVER commit the real .env
# (it is already excluded via .gitignore). All variables below match
# app/config.py (pydantic Settings, case-sensitive).

PROJECT_NAME="UPSKILL AI"
API_V1_STR="/api/v1"

# Comma-separated list of allowed frontend origins (FastAPI CORSMiddleware).
# Keep localhost entries for local development and ADD your deployed frontend
# origin for production, e.g.:
#   BACKEND_CORS_ORIGINS=["https://upskill-ai.vercel.app","http://localhost:5173"]
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (SQLite file by default for the MVP). SQLAlchemy URL format.
# For production PostgreSQL use, e.g.:
#   DATABASE_URL="postgresql+psycopg://user:password@host:5432/upskill"
DATABASE_URL="sqlite:///./statlearn_ai.db"

# OpenRouter AI configuration. AI calls happen ONLY from the backend; the key
# is never sent to or stored in the frontend.
OPENROUTER_API_KEY=""
# Which OpenRouter model to use. "openrouter/free" auto-routes to a free model.
# Free-tier model slugs change over time; if generation fails with model errors,
# set a current free chat slug here, e.g.:
#   OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# JWT authentication. Generate a strong secret for any shared/deployed
# environment, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never use the default dev value in production.
JWT_SECRET_KEY="upskill-dev-secret-change-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
