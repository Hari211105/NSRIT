# UPSKILL AI - backend environment variables
#
# Copy this file to `.env` and fill in real values. NEVER commit the real .env
# (it is already excluded via .gitignore). All variables below match
# app/config.py (pydantic Settings, case-sensitive).

PROJECT_NAME="UPSKILL AI"
API_V1_STR="/api/v1"

# Environment: "development" | "production" | "testing"
# When set to "production", the server will refuse to start if JWT_SECRET_KEY
# is missing or still equals the dev default.
ENVIRONMENT="development"

# Port (bound dynamically in container environments such as Render, Railway, Fly.io)
PORT=8000

# Allowed frontend origins (FastAPI CORSMiddleware).
# Can be supplied as a JSON array or comma-separated list of origins.
# In production, add your deployed Vercel frontend URL, e.g.:
#   BACKEND_CORS_ORIGINS=["https://upskill-ai.vercel.app","http://localhost:5173"]
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database URL.
# Local SQLite default:
DATABASE_URL="sqlite:///./statlearn_ai.db"
# Managed PostgreSQL (Neon, Supabase, Render Postgres, AWS RDS):
#   DATABASE_URL="postgresql+psycopg://username:password@hostname:5432/dbname"

# OpenRouter AI configuration. AI calls happen ONLY from the backend; the key
# is never sent to or stored in the frontend.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# JWT authentication. Generate a strong random key for production:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be changed when ENVIRONMENT=production.
JWT_SECRET_KEY="upskill-dev-secret-change-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
